// MentalMap — Firestore security rules.
//
// Not wired to any CLI/deploy tooling (this repo has no build system and no
// firebase.json) — paste this into Firebase Console → Firestore Database →
// Rules → publish, whenever it changes.
//
// Person records are stored as plain fields — there is no client-side
// encryption (see firebase-sync.js for why). This per-uid restriction is
// therefore the only protection: even a compromised or buggy client can
// never read or write another user's subtree, but the data itself is only
// as private as this rule and the Firebase project's own access controls.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /people/{personId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'answers', 'answerIndices', 'gateAnswer', 'secretCap', 'gradientIndex', 'updatedAt', 'updatedAtClient']);
      }

      // App preferences (currently just the level-field view) — one small doc,
      // not a per-item collection like people.
      match /settings/{settingsDoc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['levelViewMode', 'levelViewOpacity', 'updatedAt']);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
